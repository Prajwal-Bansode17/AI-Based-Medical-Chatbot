# ============================================================
# MedAssist AI - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env or secrets to version control.
# ============================================================

# Gemini AI API Configuration (Multimodal Vision & Fallback LLM)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama LLM Configuration (Text Queries)
# Set to 1 to enable local offline inference, 0 to disable
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=medassist:latest
AI_PRIMARY_PROVIDER=auto

# Server & Rate Limiting Configuration
PORT=5000
RATE_LIMIT_PER_MINUTE=120

# Database & Local Storage
# Default SQLite chat and long-term memory database path
CHAT_DB_FILE=ml/data/chat_history.db

# Supabase Cloud Configuration (Android Client & Cloud Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
